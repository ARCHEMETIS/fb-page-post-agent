# Choose a long random value; the external draft-writing agent sends it in x-api-key.
SUBMIT_DRAFT_SECRET=

# Create a bot in the Discord Developer Portal and copy its token.
DISCORD_BOT_TOKEN=

# Copy the application's Public Key from the Discord Developer Portal General Information page.
DISCORD_PUBLIC_KEY=

# Enable Developer Mode in Discord, then copy the target channel ID.
DISCORD_CHANNEL_ID=

# Copy the numeric ID of the Facebook Page that will receive approved posts.
FACEBOOK_PAGE_ID=

# Generate a Page access token with permission to publish Page content in Meta's developer tools.
FACEBOOK_PAGE_ACCESS_TOKEN=
